APP_NAME=SouulBi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# true = vistas branded (errors/*) cuando APP_DEBUG=false | false = detalle de excepción
APP_CUSTOM_ERROR_PAGES=false
APP_URL=http://localhost
# En Railway/producción: APP_URL=https://tu-app.up.railway.app

APP_TIMEZONE=America/Bogota

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=viservice
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Volumen de datos montado fuera del proyecto. Si se omite, se usa storage/app/media.
# Se separa por entorno según APP_ENV: production/ para producción y test/ para
# local y staging. Dentro de cada uno: public/ (servida en /media) y private/.
# MEDIA_ROOT=/mnt/volume_1788109425429/souulbi
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#DIAN — facturación electrónica (proveedor TITANIO / Delcop)
URL_TEST=https://www-prueba.titanio.com.co/
NIT_DELCOP=
USER_DELCOP=
PASSWORD_DELCOP=
TR_TIPO_ID_DELCOP=

# Datos de la resolución del emisor. La clave técnica y el PIN salen del portal
# de habilitación de la DIAN y no se versionan.
DIAN_TECHNICAL_KEY=
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=
DIAN_NEXT_CONSECUTIVE=1

#BOLD — pasarela de pagos en línea de las suscripciones
# Son dos llaves distintas y no se pueden intercambiar: identity autentica
# nuestras llamadas a la API; secret verifica la firma de los webhooks.
IDENTITY_KEY_BOLD=
SECRET_KEY_BOLD=
BOLD_BASE_URL=https://integrations.api.bold.co
BOLD_TIMEOUT=20
BOLD_LINK_EXPIRATION_HOURS=72

# Bold no siempre firma con la misma llave: depende del tipo de integración por
# el que entró el pago (la de «Botón de pagos» o la de «API Datáfono»). Si un
# pago real se rechaza por firma, la bitácora bold_webhook_events lo dice y la
# llave que falte se agrega aquí, separada por comas.
BOLD_WEBHOOK_EXTRA_SECRETS=

# En pruebas Bold puede firmar con llave vacía. Se acepta ADEMÁS de las llaves
# reales, no en su lugar. Dejar en false en producción: en true cualquiera que
# conozca la URL puede firmar sin llave.
BOLD_WEBHOOK_TEST_MODE=false

# Webhook a configurar en el panel de Bold: https://<dominio>/webhooks/bold

#SUSCRIPCIONES — negocio dueño de la plataforma, emisor de las facturas de
# suscripción y dueño de los productos de cada plan. No se puede eliminar.
SUBSCRIPTIONS_OWNER_BUSINESS_ID=1

#STORAGE — ruta del volumen en el servidor; en local se deja vacía
MEDIA_ROOT=
