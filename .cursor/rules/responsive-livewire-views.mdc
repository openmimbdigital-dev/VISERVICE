- Card: `rounded-2xl border border-slate-200/90 bg-white shadow-sm`
- Footer acciones: `flex flex-col-reverse gap-2 sm:flex-row sm:justify-end`
- Botones: `.btn .btn-primary`, `.btn-outline-secondary`

